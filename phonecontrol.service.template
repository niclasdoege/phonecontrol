[Unit]
Description=Phone Control Server
After=network.target

[Service]
Type=simple
User={{PHONECONTROL_USER}}
WorkingDirectory={{PHONECONTROL_DIR}}
ExecStart={{PHONECONTROL_DIR}}/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
Environment=ADB_VENDOR_KEYS={{ADB_VENDOR_KEYS}}
# Allow adb to find USB devices.
SupplementaryGroups=plugdev

[Install]
WantedBy=multi-user.target
