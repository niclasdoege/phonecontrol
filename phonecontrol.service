[Unit]
Description=Phone Control Server
After=network.target

[Service]
Type=simple
User=niclas
WorkingDirectory=/home/niclas/phonecontrol
ExecStart=/home/niclas/phonecontrol/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 9080
Restart=on-failure
RestartSec=5
Environment=ADB_VENDOR_KEYS=/home/niclas/.android
# Allow adb to find USB devices
SupplementaryGroups=plugdev

[Install]
WantedBy=multi-user.target
